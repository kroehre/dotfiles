mux() {
  local name cols agent="" kill=0 dir=""

  mux_usage() {
    echo "usage: mux [--claude|--codex] [-K] [dir]" >&2
  }

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --claude|--codex)
        if [ -n "$agent" ]; then
          mux_usage
          return 64
        fi
        agent="${1#--}"
        ;;
      -K) kill=1 ;;
      -*)
        mux_usage
        return 64
        ;;
      *)
        if [ -n "$dir" ]; then
          mux_usage
          return 64
        fi
        dir="$1"
        ;;
    esac
    shift
  done

  if [ -n "$dir" ]; then
    cd "$dir" || return
  fi

  name="$(basename "$PWD" | sed -e 's/\./-/g')"

  if (( kill )); then
    tmux -L mux kill-session -t "$name" 2>/dev/null
    tmux kill-session -t "$name" 2>/dev/null
    return
  fi

  cols="$(tput cols)"

  if [ -n "$agent" ]; then
    local wrapper="$DOTHOME/$agent/mux-$agent"
    local prompt_template="$DOTHOME/$agent/mux-prompt.md"

    # Create inner project session on default server
    if ! tmux has-session -t "$name" 2>/dev/null; then
      tmux new-session -d -n changes -s "$name" -x${cols:-150} -y50 \
        "$DOTHOME/bin/mux-changes"
      tmux new-window -a -d -n codeburn -t "$name:0" "codeburn; exec $SHELL"
      tmux new-window -a -d -n tests -t "$name:1"
      tmux new-window -a -d -n server -t "$name:2"
    fi

    # Create outer container on separate socket
    if ! tmux -L mux has-session -t "$name" 2>/dev/null; then
      local prompt_file="$HOME/.$agent/mux-prompt-$name.md"
      sed "s/\$SESSION/$name/g" "$prompt_template" > "$prompt_file"
      tmux -L mux -f "$DOTHOME/tmux/agent-container.conf" \
        new-session -d -s "$name" -x${cols:-150} -y50 \
        "MUX_SESSION='$name' $wrapper '$prompt_file'"
      tmux -L mux split-window -t "$name" -h -l 30% \
        "TMUX= tmux attach-session -t '$name'"
      tmux -L mux select-pane -t "$name:0.0"
    fi

    tmux -L mux attach-session -t "$name"
  else
    if ! tmux has-session -t "$name" 2>/dev/null; then
      tmux new-session -d -n code -s "$name" -x${cols:-150} -y50 && \
        tmux new-window -a -d -n tests -t "$name:0" \; \
        new-window -a -d -n server -t "$name:1" \; \
        select-layout -t "$name" main-vertical &>/dev/null
    fi

    tmux attach-session -t "$name"
  fi
}
