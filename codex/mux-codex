#!/bin/zsh
# Runs Codex in a loop with a menu on exit.
# Used by `mux --codex` as the outer container pane command.

prompt_file="$1"
codex_args=(
  -c developer_instructions="$(cat "$prompt_file")"
  --ask-for-approval never
  --sandbox workspace-write
)

codex "${codex_args[@]}"

while true; do
  echo
  echo "[c] Continue last session"
  echo "[n] New session"
  echo "[q] Quit"
  echo
  read -sk1 "choice?"
  case "$choice" in
    c) codex resume --last "${codex_args[@]}" ;;
    n) codex "${codex_args[@]}" ;;
    q) name="$(tmux -L mux display-message -p '#S')"
       tmux -L default kill-session -t "$name" 2>/dev/null
       tmux -L mux kill-session -t "$name" 2>/dev/null
       exit ;;
    *) echo "Invalid choice" ;;
  esac
done
